# Environment variables for the React frontend (Create React App)
# Copy this file to `.env` and fill in your own values locally.
# Do NOT commit your populated .env file.

# Supabase project URL (e.g., https://xyzcompany.supabase.co)
REACT_APP_SUPABASE_URL=

# Supabase anon public key (Project Settings -> API -> anon key)
REACT_APP_SUPABASE_ANON_KEY=

# Optional: Site URL used for auth email redirects (if building auth flows)
# REACT_APP_SITE_URL=http://localhost:3000
